// markdownlint config — permissive on prose style, strict on real defects
{
  "default": true,
  "MD013": false,                       // line length
  "MD022": false,                       // blanks around headings
  "MD024": { "siblings_only": true },   // duplicate headings allowed in different sections
  "MD031": false,                       // blanks around fenced code
  "MD032": false,                       // blanks around lists
  "MD033": false,                       // inline HTML
  "MD034": false,                       // bare URLs
  "MD036": false,                       // emphasis used as heading
  "MD040": false,                       // fenced code language
  "MD041": false,                       // first line must be top-level heading
  "MD059": false                        // descriptive link text
}
